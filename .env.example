# =========================================================================
# CONFIGURACIÓN LOCAL DE VARIABLES DE ENTORNO (FinanceAI)
# =========================================================================
# Instrucciones: 
# 1. Copia este archivo y renombralo como '.env' en esta misma carpeta.
# 2. Reemplaza los valores de prueba por tus credenciales reales.
# 3. El archivo '.env' real está excluido en el .gitignore y nunca debe subirse.

# Configuración de Base de Datos PostgreSQL
DB_NAME=financeai_db
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_PORT_HOST=5433

# Configuración OCI (Oracle Cloud Infrastructure)
OCI_STORAGE_BUCKET=financeai-bucket
# OCI_ACCESS_KEY=tu_key_aqui
# OCI_SECRET_KEY=tu_secret_aqui
