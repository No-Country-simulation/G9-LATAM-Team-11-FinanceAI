# Enforce LF line endings for files that will be executed in Linux/Docker containers
# This prevents the classic Windows error: "bash: ...: /bin/sh^M: bad interpreter"
* text=auto

*.sh text eol=lf
mvnw text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
