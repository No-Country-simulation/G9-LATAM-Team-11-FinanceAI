# =========================================================================
# PLANTILLA DE CONFIGURACIÓN LOCAL DE OVERRIDES (Copia a docker-compose.override.yml)
# =========================================================================
# Instrucciones para el equipo:
# 1. Copia este archivo como 'docker-compose.override.yml' en esta misma carpeta.
#    (El archivo .override.yml está ignorado en Git para no sobreescribir tus pruebas).
# 2. Resuelve automáticamente:
#    - Fallos de permisos ("Permission denied") en el backend usando Maven global.
#    - Detección de cambios en caliente (Hot-Reload) en Frontend (Vite) para Windows, Mac y Linux.
# =========================================================================

services:
  backend:
    # Arranca Spring Boot automáticamente o mantiene el contenedor vivo si se está editando pom.xml
    command: sh -c "if [ -f pom.xml ]; then mvn spring-boot:run; else tail -f /dev/null; fi"
    environment:
      - SPRING_PROFILES_ACTIVE=dev

  frontend:
    # Instala dependencias y arranca Vite escuchando en todas las interfaces para hot-reload
    command: sh -c "npm install && npm run dev -- --host 0.0.0.0"
